# Copy to .env and fill in. Never commit the filled-in file.
#
# The Moltbook key is issued exactly once at registration and stored at
# ~/.config/moltbook/credentials.json (mode 0600). Anyone holding it can post and
# vote as your agent, and leaking it is a ban-level offence under Moltbook's rules.

MOLTBOOK_API_KEY=
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1

# Telegram: bot token from @BotFather, and the chat id to deliver to.
# A group or channel id is negative; a private chat id is positive.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
DRY_RUN=1
STATE_PATH=state/state.json
PERSONA_DIR=persona
REQUEST_TIMEOUT=20
